// Firebase Storage Security Rules
// วางไฟที่: storage.rules (copy ไปใน Firebase Console)
//
// Firebase Console → Storage → Rules → วาง rules ลงไป → Publish

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile-photos/{uid}/{fileName} {
      // รูปโปรไฟล์อ่านได้สาธารณะ (แสดงบนหน้าโปรไฟล์/explore)
      allow read: if true;
      // อัปโหลด/ลบได้เฉพาะเจ้าของ
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
