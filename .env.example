# Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Admin SDK
# Use ADMIN_FIREBASE_* for Firebase Functions because FIREBASE_* is a reserved env prefix.
ADMIN_FIREBASE_PROJECT_ID=your-project-id
ADMIN_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
ADMIN_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Local emulator
FIREBASE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_EMULATOR=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment (Stripe Checkout + Connect)
# เริ่มด้วย mock ได้เมื่อยังไม่มี Stripe key; ตั้ง PAYMENT_PROVIDER=stripe ใน Test Mode
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_LIVE_ENABLED=false

# PromptPay / บัญชีรับเงิน (สำหรับ mock และวิธีโอนเงิน/แจ้งสลิป)
PROMPTPAY_NUMBER=088-XXX-XXXX
PROMPTPAY_OWNER=TutorFinder Co., Ltd.
BANK_ACCOUNT_NAME=ธนาคารกสิกรไทย
BANK_ACCOUNT_HOLDER=บริษัท TutorFinder จำกัด
BANK_ACCOUNT_NUMBER=XXX-X-XXXXX-X

# LINE Messaging API + LIFF
NEXT_PUBLIC_LINE_LIFF_ID=your-liff-id
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_OFFICIAL_ACCOUNT_ID=@966mqfzj
LINE_NOTIFICATIONS_ENABLED=false
LINE_RICH_MENU_PARENT_ID=
LINE_RICH_MENU_TEACHER_ID=
LINE_RICH_MENU_DEFAULT_ID=

# OpenAI - Phase 2 (AI lesson planner)
OPENAI_API_KEY=sk-xxx
