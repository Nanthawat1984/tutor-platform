// Firestore Security Rules
// วางไฟที่: firestore.rules (copy ไปใน Firebase Console)
//
// Firebase Console → Firestore Database → Rules → วาง rules ลงไป → Publish

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTeacher() {
      return isAuth() && getUserRole() == 'teacher';
    }

    function isParent() {
      return isAuth() && getUserRole() == 'parent';
    }

    function isAdmin() {
      return isAuth() && getUserRole() == 'admin';
    }

    function isTeacherOrAdmin() {
      return isTeacher() || isAdmin();
    }

    // =============================================
    // USERS
    // =============================================
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Profiles are created and updated by the server after Firebase Auth
      // verification. Client-side creation would let a user self-assign admin.
      allow create: if false;
      allow update: if isAdmin() || (
        isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isVerified', 'verificationLevel',
          'kycStatus', 'kycNote', 'kycSubmittedAt',
          'payoutBankName', 'payoutAccountName', 'payoutAccountNumber',
          'bookBankURL', 'idCardURL',
          'lineUserId', 'lineLinkedAt', 'lineNotificationEnabled'
        ])
      );
      allow delete: if isAdmin();
    }

    // =============================================
    // TEACHERS
    // =============================================
    match /teachers/{uid} {
      allow read: if true; // public
      // Teacher stats and verification-sensitive fields are server-managed.
      allow write: if isAdmin();
    }

    // =============================================
    // CENTERS
    // =============================================
    match /centers/{centerId} {
      allow read: if true; // public
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // =============================================
    // SUBJECTS (read-only)
    // =============================================
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =============================================
    // COURSES
    // =============================================
    match /courses/{courseId} {
      allow read: if true; // public
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // =============================================
    // SCHEDULES
    // =============================================
    match /schedules/{scheduleId} {
      allow read: if resource.data.isActive == true;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // =============================================
    // BOOKINGS
    // =============================================
    match /bookings/{bookingId} {
      allow read: if isAuth() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false; // server validates course, student, schedule and payment setup
      // Booking transitions can release escrow; they must go through the
      // server actions/webhooks so a client cannot mark a booking completed.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =============================================
    // ATTENDANCE
    // =============================================
    match /attendance/{attendanceId} {
      allow read: if isAuth() && (isAdmin() || resource.data.teacherId == request.auth.uid || get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.parentId == request.auth.uid);
      allow create: if false; // server/Admin SDK only
      allow update: if false; // server/Admin SDK only
      allow delete: if isAdmin();
    }

    // =============================================
    // SESSION REPORTS
    // =============================================
    match /sessionReports/{reportId} {
      allow read: if isAuth() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false; // server/Admin SDK only
      allow update: if false; // server/Admin SDK only
      allow delete: if isAdmin();
    }

    // =============================================
    // STUDENTS (ลูกของผู้ปกครอง)
    // =============================================
    match /students/{studentId} {
      allow read: if isAuth() && (
        resource.data.parentId == request.auth.uid || isAdmin()
      );
      allow create: if isParent() && request.resource.data.parentId == request.auth.uid;
      allow update: if isParent() && resource.data.parentId == request.auth.uid && request.resource.data.parentId == resource.data.parentId;
      allow delete: if isParent() && resource.data.parentId == request.auth.uid;
    }

    // =============================================
    // REVIEWS
    // =============================================
    match /reviews/{reviewId} {
      allow read: if resource.data.isVisible == true;
      allow create: if false; // server/Admin SDK only; server validates completed booking
      allow update: if isAdmin(); // moderation
      allow delete: if isAdmin();
    }

    // =============================================
    // NOTIFICATIONS
    // =============================================
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow create: if false; // server/Admin SDK only
    }

    // LINE delivery outbox — server/Admin SDK only
    match /lineNotificationOutbox/{notificationId} {
      allow read, write: if false;
    }

    // =============================================
    // PAYMENTS
    // =============================================
    match /payments/{paymentId} {
      // Payment documents contain internal fees, payout amounts, provider
      // references and private slip paths. All current UI reads use Admin SDK.
      allow read: if false;
      allow create: if false; // server/Admin SDK only
      allow update: if isAdmin(); // webhook/Admin SDK ใช้สิทธิ์นี้
    }

    // =============================================
    // WALLETS (กระเป๋าเงินครู — escrow)
    // =============================================
    match /wallets/{teacherId} {
      allow read: if false;
      allow write: if isAdmin(); // อัปเดตผ่าน server/Admin SDK เท่านั้น
    }

    // =============================================
    // PAYOUTS (การเบิกเงินครู)
    // =============================================
    match /payouts/{payoutId} {
      allow read: if false;
      allow create: if false; // server validates KYC, balance and open requests
      allow update: if isAdmin();
    }
  }
}
