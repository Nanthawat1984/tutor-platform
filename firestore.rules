// Firestore Security Rules
// วางไฟที่: firestore.rules (copy ไปใน Firebase Console)
//
// Firebase Console → Firestore Database → Rules → วาง rules ลงไป → Publish

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTeacher() {
      return isAuth() && getUserRole() == 'teacher';
    }

    function isParent() {
      return isAuth() && getUserRole() == 'parent';
    }

    function isAdmin() {
      return isAuth() && getUserRole() == 'admin';
    }

    function isTeacherOrAdmin() {
      return isTeacher() || isAdmin();
    }

    // =============================================
    // USERS
    // =============================================
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isAdmin() || (
        isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isVerified', 'verificationLevel',
          'kycStatus', 'kycNote', 'kycSubmittedAt',
          'payoutBankName', 'payoutAccountName', 'payoutAccountNumber',
          'bookBankURL', 'idCardURL',
          'lineUserId', 'lineLinkedAt', 'lineNotificationEnabled'
        ])
      );
      allow delete: if isAdmin();
    }

    // =============================================
    // TEACHERS
    // =============================================
    match /teachers/{uid} {
      allow read: if true; // public
      allow write: if isOwner(uid) || isAdmin();
    }

    // =============================================
    // CENTERS
    // =============================================
    match /centers/{centerId} {
      allow read: if true; // public
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // =============================================
    // SUBJECTS (read-only)
    // =============================================
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =============================================
    // COURSES
    // =============================================
    match /courses/{courseId} {
      allow read: if true; // public
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // =============================================
    // SCHEDULES
    // =============================================
    match /schedules/{scheduleId} {
      allow read: if resource.data.isActive == true;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // =============================================
    // BOOKINGS
    // =============================================
    match /bookings/{bookingId} {
      allow read: if isAuth() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isParent() && request.resource.data.parentId == request.auth.uid && request.resource.data.teacherId == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.teacherId && request.resource.data.totalPrice == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.pricePerSession;
      allow update: if isAdmin() || (isAuth() && (resource.data.parentId == request.auth.uid || resource.data.teacherId == request.auth.uid) && request.resource.data.parentId == resource.data.parentId && request.resource.data.teacherId == resource.data.teacherId && request.resource.data.courseId == resource.data.courseId && request.resource.data.totalPrice == resource.data.totalPrice && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // =============================================
    // ATTENDANCE
    // =============================================
    match /attendance/{attendanceId} {
      allow read: if isAuth() && (isAdmin() || resource.data.teacherId == request.auth.uid || get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.parentId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // =============================================
    // SESSION REPORTS
    // =============================================
    match /sessionReports/{reportId} {
      allow read: if isAuth() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.teacherId == request.auth.uid && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.parentId == request.resource.data.parentId;
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId && request.resource.data.parentId == resource.data.parentId && request.resource.data.bookingId == resource.data.bookingId);
      allow delete: if isAdmin();
    }

    // =============================================
    // STUDENTS (ลูกของผู้ปกครอง)
    // =============================================
    match /students/{studentId} {
      allow read: if isAuth() && (
        resource.data.parentId == request.auth.uid || isAdmin()
      );
      allow create: if isParent() && request.resource.data.parentId == request.auth.uid;
      allow update: if isParent() && resource.data.parentId == request.auth.uid;
      allow delete: if isParent() && resource.data.parentId == request.auth.uid;
    }

    // =============================================
    // REVIEWS
    // =============================================
    match /reviews/{reviewId} {
      allow read: if resource.data.isVisible == true;
      allow create: if isParent() && request.resource.data.parentId == request.auth.uid && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.parentId == request.auth.uid && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.teacherId == request.resource.data.teacherId && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update: if isAdmin(); // moderation
      allow delete: if isAdmin();
    }

    // =============================================
    // NOTIFICATIONS
    // =============================================
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow create: if false; // server/Admin SDK only
    }

    // LINE delivery outbox — server/Admin SDK only
    match /lineNotificationOutbox/{notificationId} {
      allow read, write: if false;
    }

    // =============================================
    // PAYMENTS
    // =============================================
    match /payments/{paymentId} {
      allow read: if isAuth() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false; // server/Admin SDK only
      allow update: if isAdmin(); // webhook/Admin SDK ใช้สิทธิ์นี้
    }

    // =============================================
    // WALLETS (กระเป๋าเงินครู — escrow)
    // =============================================
    match /wallets/{teacherId} {
      allow read: if isOwner(teacherId) || isAdmin();
      allow write: if isAdmin(); // อัปเดตผ่าน server/Admin SDK เท่านั้น
    }

    // =============================================
    // PAYOUTS (การเบิกเงินครู)
    // =============================================
    match /payouts/{payoutId} {
      allow read: if isAuth() && (
        resource.data.teacherId == request.auth.uid || isAdmin()
      );
      allow create: if isTeacher();
      allow update: if isAdmin();
    }
  }
}
